WA_ITEMS = [
    ("K3", "A company plans to paste full resumes into a public GenAI tool to generate interview questions. Identify three legal, ethical or socio-cultural controls the interviewer must apply before using the tool, and explain why each control matters."),
    ("K4", "Explain how an interview objective is converted into a measurable evidence contract. Your answer must link a role task, competency, observable behaviour and decision rule."),
    ("K1", "Compare structured, behavioural, situational and technical interview formats. State the evidence each format is best suited to elicit and one limitation of relying on it alone."),
    ("K5", "An AI system generates: 'You are comfortable working late and handling family commitments, right?' Diagnose the question defects and rewrite it as a neutral, job-related question with an allowed probe."),
    ("K2", "A panel gives one candidate scores of 2, 3 and 5 for the same competency. Describe the evidence-based calibration process the panel should use, including how it should treat missing evidence."),
    ("K6", "Describe an active-listening and probing sequence for a vague candidate answer. Explain how the interviewer can clarify evidence without coaching the candidate."),
]

WA_ANSWERS = [
    ["Apply purpose limitation and data minimisation: remove identifiers and unrelated data before prompting.", "Use only an approved provider and document transfer, access and retention controls.", "Audit the generated questions for job relevance, protected-trait proxies and unfair assumptions.", "Keep a human decision owner who can reject AI output and explain the final use."],
    ["Start with a critical role task or output.", "Identify the competency required to perform it.", "Describe observable behaviour or evidence that demonstrates the competency.", "Write questions and score anchors, including minimum threshold and N/E handling."],
    ["Structured interviews use common core questions and anchors for comparable evidence.", "Behavioural questions elicit past incidents and personal action but depend on recall and opportunity.", "Situational questions elicit reasoning under assumptions but may not predict actual behaviour alone.", "Technical questions test applied role knowledge but must avoid trivia and should include verification/trade-offs."],
    ["The item is leading, combines availability with family status, and risks protected/private information.", "Rewrite: 'This role requires two scheduled evening deployments per quarter. Describe any availability constraints relevant to that requirement.'", "Allowed probe: 'What arrangement would allow you to meet the published schedule?'", "Ask all candidates consistently and score only role availability evidence."],
    ["Raters lock independent scores before discussion.", "Each rater cites transcript facts against the same anchor.", "Discuss discrepancies of two or more points and identify whether evidence or anchor interpretation differs.", "Use N/E for missing evidence rather than averaging or inventing a score; document any change."],
